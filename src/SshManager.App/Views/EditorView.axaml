<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SshManager.App.ViewModels"
             xmlns:v="using:SshManager.App.Views"
             xmlns:services="using:SshManager.App.Services"
             x:Class="SshManager.App.Views.EditorView"
             x:DataType="vm:EditorTabViewModel">
  <DockPanel>
    <!-- 顶部工具条 -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource C_Card2}" CornerRadius="10"
            Padding="14,8,12,8">
      <!-- 窄窗口时元数据组与按钮组整体换行，避免元数据溢出压住保存/关闭按钮 -->
      <WrapPanel>
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                    Height="30" Margin="0,0,12,6">
          <Path Classes="icon c-acc" Data="{StaticResource IcFileText}" Width="16" Height="16"
                VerticalAlignment="Center"/>
          <TextBlock Classes="t-h2" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                     MaxWidth="260" ToolTip.Tip="{Binding Path}" VerticalAlignment="Center"/>
          <Border Classes="badge" IsVisible="{Binding IsModified}" Background="#3a1f27"
                  VerticalAlignment="Center" ToolTip.Tip="有未保存的修改">
            <TextBlock Text="未保存" FontSize="10.5" Foreground="{DynamicResource C_Danger}"/>
          </Border>
          <Border Classes="badge" VerticalAlignment="Center">
            <TextBlock Text="{Binding EncodingText}" FontSize="10.5" Classes="t-dim"
                       FontFamily="{StaticResource MonoFont}"/>
          </Border>
          <Border Classes="badge" VerticalAlignment="Center">
            <TextBlock Text="{Binding NewlineText}" FontSize="10.5" Classes="t-dim"
                       FontFamily="{StaticResource MonoFont}"/>
          </Border>
          <Border Classes="badge" IsVisible="{Binding WasReadWithSudo}" Background="#2a2312"
                  VerticalAlignment="Center"
                  ToolTip.Tip="当前用户无权读取该文件，内容经 sudo 提权读取；保存时同样会提权（保留原属主与权限）">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Path Stretch="Uniform" Data="{StaticResource IcKey}" Stroke="{DynamicResource C_Warn}"
                    StrokeThickness="1.6" StrokeJoin="Round" Width="10" Height="10" VerticalAlignment="Center"/>
              <TextBlock Text="sudo 读取" FontSize="10.5" Foreground="{DynamicResource C_Warn}"/>
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                    Margin="0,0,0,6">
          <Button Classes="primary" Height="30" Padding="14,3" FontSize="12.5"
                  Command="{Binding SaveCommand}"
                  IsEnabled="{Binding IsSaving, Converter={x:Static services:Converters.Not}}"
                  ToolTip.Tip="保存到服务器 (Ctrl+S)">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Path Stretch="Uniform" Data="{StaticResource IcCheck}" Stroke="{DynamicResource C_AccFg}"
                    StrokeThickness="2" StrokeJoin="Round" VerticalAlignment="Center"
                    Width="13" Height="13"/>
              <TextBlock Text="保存"/>
            </StackPanel>
          </Button>
          <ToggleButton Classes="tab" Height="30" Padding="10,3" FontSize="12"
                        IsChecked="{Binding UseWrap, Mode=TwoWay}"
                        ToolTip.Tip="自动换行开关" Content="换行"/>
          <Button Classes="ghost" Height="30" Padding="10,3" FontSize="12.5"
                  Command="{Binding DiscardCommand}" IsVisible="{Binding IsModified}"
                  ToolTip.Tip="放弃全部修改，恢复到上次保存的内容" Content="放弃修改"/>
          <Button Classes="ghost" Height="30" Padding="10,3" FontSize="12.5"
                  Command="{Binding CloseAllCommand}"
                  ToolTip.Tip="关闭全部编辑标签页（有未保存修改的会先询问）" Content="全部关闭"/>
          <Button Classes="ghost" Height="30" Padding="10,3" FontSize="12.5"
                  Command="{Binding CloseCommand}" ToolTip.Tip="关闭此标签页（未保存会先询问）"
                  Content="关闭"/>
        </StackPanel>
      </WrapPanel>
    </Border>

    <!-- 底部状态条 -->
    <Border DockPanel.Dock="Bottom" Padding="2,8,2,2">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="18">
        <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource C_Danger}"
                   FontSize="11.5" TextTrimming="CharacterEllipsis" MaxWidth="430"
                   ToolTip.Tip="{Binding StatusText}"/>
        <TextBlock Grid.Column="1" Text="{Binding Path}" Classes="t-dim" FontSize="11"
                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}"/>
        <TextBlock Grid.Column="2" Text="{Binding StatsText}" Classes="t-dim" FontSize="11"/>
        <TextBlock Grid.Column="3" Text="{Binding CaretText}" Classes="t-dim" FontSize="11"
                   FontFamily="{StaticResource MonoFont}"/>
      </Grid>
    </Border>

    <!-- 编辑区（占满剩余空间） -->
    <Border Classes="card" Padding="0" ClipToBounds="True" Margin="0,10,0,10" MinHeight="220">
      <v:EditorTextBox Classes="editor" Text="{Binding Text, Mode=TwoWay}"
                       TextWrapping="{Binding UseWrap, Converter={x:Static services:Converters.BoolToWrap}}"/>
    </Border>
  </DockPanel>
</UserControl>
