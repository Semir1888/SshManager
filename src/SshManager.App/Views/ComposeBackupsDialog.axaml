<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SshManager.App.ViewModels"
        x:Class="SshManager.App.Views.ComposeBackupsDialog"
        x:DataType="vm:ComposeBackupsViewModel"
        Title="Compose 项目备份" Width="800" Height="560" MinWidth="680" MinHeight="440"
        CanResize="True" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource C_Bg}">
  <Grid Margin="16" RowDefinitions="Auto,*,Auto">

    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,10">
      <TextBlock Classes="t-title" Text="{Binding ProjectTitle, StringFormat='项目备份：{0}'}"/>
      <TextBlock Text="{Binding BackupDirText}" Classes="mono" FontSize="11"
                 Foreground="{DynamicResource C_Fg3}" TextTrimming="CharacterEllipsis"
                 ToolTip.Tip="{Binding BackupDirText}"/>
      <TextBlock Classes="t-dim" FontSize="11.5"
                 Text="恢复会用备份覆盖项目文件，并执行 docker compose up -d --force-recreate。"/>
    </StackPanel>

    <DockPanel Grid.Row="1">

      <!-- 操作日志 -->
      <Border DockPanel.Dock="Bottom" Classes="card sub" Padding="8" Height="112"
              Margin="0,8,0,0" ClipToBounds="True">
        <ScrollViewer x:Name="LogScroller"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <SelectableTextBlock Text="{Binding LogText}" FontFamily="{StaticResource MonoFont}"
                               FontSize="11.5" TextWrapping="NoWrap"
                               Foreground="{DynamicResource C_Fg2}"/>
        </ScrollViewer>
      </Border>

      <Border Classes="card" Padding="0" ClipToBounds="True" MinHeight="120">
        <Panel>
          <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False"
                    IsReadOnly="True" CanUserResizeColumns="True"
                    HeadersVisibility="Column" GridLinesVisibility="None"
                    SelectionMode="Single"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Auto"
                    Background="Transparent" BorderThickness="0"
                    RowBackground="Transparent"
                    IsVisible="{Binding !IsEmpty}">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="时间" Width="160">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ComposeBackupRowViewModel">
                    <TextBlock Text="{Binding TimeText}" FontSize="11.5"
                               VerticalAlignment="Center"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="备份文件" Width="*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ComposeBackupRowViewModel">
                    <TextBlock Text="{Binding Name}" Classes="mono" FontSize="11.5"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding Name}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="大小" Width="96">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ComposeBackupRowViewModel">
                    <TextBlock Text="{Binding SizeText}" FontSize="11.5"
                               Foreground="{DynamicResource C_Fg3}"
                               VerticalAlignment="Center"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="操作" Width="160">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ComposeBackupRowViewModel">
                    <StackPanel Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center">
                      <Button Classes="ghost" Content="恢复" Height="26" Padding="10,2"
                              FontSize="11" Command="{Binding RestoreCommand}"/>
                      <Button Classes="danger" Content="删除" Height="26" Padding="10,2"
                              FontSize="11" Command="{Binding DeleteCommand}"/>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>

          <StackPanel IsVisible="{Binding IsEmpty}" Spacing="8"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
            <Path Classes="icon c-dim" Data="{StaticResource IcArchive}" Width="28" Height="28"
                  HorizontalAlignment="Center"/>
            <TextBlock Text="暂无备份。执行一次“升级”后会自动生成。" Classes="t-dim"
                       HorizontalAlignment="Center"/>
          </StackPanel>
        </Panel>
      </Border>
    </DockPanel>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="0,12,0,0">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <ProgressBar Classes="slim" Width="16" IsIndeterminate="True"
                     IsVisible="{Binding IsBusy}" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding StatusText}" Classes="t-dim" FontSize="11.5"
                   TextTrimming="CharacterEllipsis"/>
      </StackPanel>
      <Button Grid.Column="1" Classes="ghost" Content="刷新" MinWidth="80"
              IsEnabled="{Binding !IsBusy}" Click="OnReload"/>
      <Button Grid.Column="2" Classes="ghost" Content="关闭" MinWidth="88"
              Click="OnClose"/>
    </Grid>
  </Grid>
</Window>
